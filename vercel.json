{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "willowlilyestate.com"
        }
      ],
      "destination": "https://www.willowlilyestate.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/explore",
      "destination": "/estate"
    },
    {
      "source": "/explore/riverside",
      "destination": "/riverside"
    },
    {
      "source": "/explore/woods",
      "destination": "/woods"
    },
    {
      "source": "/explore/courtyard",
      "destination": "/courtyard"
    },
    {
      "source": "/explore/covered-bridge",
      "destination": "/covered-bridge"
    },
    {
      "source": "/wedding-weekend",
      "destination": "/weekend"
    },
    {
      "source": "/whats-included",
      "destination": "/included"
    },
    {
      "source": "/explore/barn",
      "destination": "/barn"
    },
    {
      "source": "/explore/gardens",
      "destination": "/gardens"
    },
    {
      "source": "/explore/waterfront",
      "destination": "/waterfront"
    },
    {
      "source": "/explore/after-dark",
      "destination": "/after-dark"
    }
  ]
}
